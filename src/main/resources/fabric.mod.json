{
	"schemaVersion": 1,
	"id": "clientprojectiles",
	"version": "${version}",
	"name": "Client Projectiles",
	"description": "Handles your projectiles client-side",
	"authors": [
		"Walksy"
	],
	"contact": {
		"issues": "https://github.com/Walksy/ClientProjectiles/issues",
		"sources": "https://github.com/Walksy/ClientProjectiles",
